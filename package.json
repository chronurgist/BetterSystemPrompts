{
  "name": "agents-local-support",
  "version": "0.1.0",
  "description": "Pi extension that expands @file references in context files and injects AGENTS.local.md instructions.",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "packageManager": "bun@1.3.14",
  "type": "module",
  "files": [
    "README.md",
    "LICENSE",
    "index.ts",
    "lib.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chronurgist/BetterSystemPrompts.git"
  },
  "homepage": "https://github.com/chronurgist/BetterSystemPrompts#readme",
  "bugs": {
    "url": "https://github.com/chronurgist/BetterSystemPrompts/issues"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@types/bun": "^1.3.0"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check": "biome check .",
    "format": "biome format . --write",
    "lint": "biome lint . --write"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
